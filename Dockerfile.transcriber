# Service de transcription — sherpa-onnx en local, hors du conteneur mediasoup
#
# Un seul moteur : le transducteur causal sherpa-onnx (architecture v2, voir
# docs/TRANSCRIPTION.md). L'audio ne quitte jamais la machine.
#
# La même image sert aux deux usages, pour que la mesure se fasse avec
# exactement la pile qui tourne en production :
#
#   · service (défaut) : docker run … stark-transcriber
#   · mesure           : docker run … stark-transcriber \
#                          python -u bench_streaming.py --model /models/<modèle> /audio/reference.wav
#
# Lancement en production : voir docs/TRANSCRIPTION.md §6. Le `cpuset` est ce
# qui protège la visio : sans lui, la reconnaissance disputerait ses cœurs à
# mediasoup et l'audio se dégraderait pendant les transcriptions.

FROM python:3.11-slim

# libopus0 : décodage Opus en bibliothèque, sans sous-processus.
# libgomp1 : requis par onnxruntime pour son parallélisme OpenMP. Absent de
#   l'image slim, et son absence ne se manifeste qu'à l'import, par une erreur
#   de bibliothèque partagée peu explicite.
RUN apt-get update && apt-get install -y --no-install-recommends \
    libgomp1 \
    libopus0 \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir \
    "fastapi>=0.110" \
    "uvicorn[standard]>=0.27" \
    numpy \
    onnxruntime \
    sherpa-onnx \
    opuslib \
    soxr

WORKDIR /app
COPY transcriber/ ./

# Réglages imposés par le cahier des charges (§4.1, §8.2) :
#  · 2 threads par processus — au-delà, rendements décroissants et contention
#  · MALLOC_ARENA_MAX — glibc allouerait sinon une arène par thread, et
#    l'empreinte mémoire se multiplierait sur une machine sans swap
ENV OMP_NUM_THREADS=2
ENV MALLOC_ARENA_MAX=2

# Modèles sherpa-onnx et Silero, posés à la main dans ce volume
# (SHERPA_MODEL_DIR, VAD_MODEL). Sans volume, ils disparaîtraient à chaque
# recréation du conteneur.
VOLUME ["/models"]

# Port d'écoute, paramétrable : sur une machine qui héberge plusieurs dizaines
# de conteneurs, 8000 est souvent déjà pris par un docker-proxy. Le figer ici
# obligerait à surcharger la commande au lancement, et le Dockerfile ne
# décrirait plus la réalité.
ENV TRANSCRIBER_PORT=8000
EXPOSE 8000

# Forme shell, indispensable pour que la variable soit interprétée : en forme
# exec, elle serait passée littéralement à uvicorn.
#
# `--network host` étant utilisé, uvicorn écoute directement sur le port de
# l'hôte : le pare-feu du VPS doit le garder fermé à l'extérieur.
CMD python -u -m uvicorn streaming:app --host 0.0.0.0 --port ${TRANSCRIBER_PORT}
