# Supabase (nouvelle instance dédiée, self-hosted via Coolify)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Mediasoup
NEXT_PUBLIC_MEDIASOUP_URL=http://localhost:3001
MEDIASOUP_PORT=3001
CLIENT_URL=http://localhost:3000
MEDIASOUP_ANNOUNCED_IP=127.0.0.1

# --- En production (Coolify) ---
# Le frontend Next.js et le serveur Mediasoup sont deux ressources Coolify
# séparées, chacune avec son propre domaine public *.sslip.io (HTTPS
# obligatoire : les navigateurs bloquent getUserMedia sur http:// non-local).
#
# NEXT_PUBLIC_APP_URL         = https://<domaine-nextjs>.sslip.io
# NEXT_PUBLIC_MEDIASOUP_URL   = https://<domaine-mediasoup>.sslip.io  (jamais l'URL interne Docker)
# CLIENT_URL                  = https://<domaine-nextjs>.sslip.io    (CORS côté mediasoup)
# MEDIASOUP_ANNOUNCED_IP      = IP publique du VPS (une IP, pas un nom de domaine — utilisée dans les candidats ICE)
