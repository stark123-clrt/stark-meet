# Dockerfile pour le serveur Mediasoup
FROM node:18

# Dépendances système. `ffmpeg` sert au fork RTP de transcription : il reçoit le
# flux Opus du SFU et le convertit en PCM 16 kHz mono.
RUN apt-get update && apt-get install -y \
    build-essential \
    python3 \
    python3-pip \
    net-tools \
    ffmpeg \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copier les fichiers de dépendances
COPY package*.json ./

# Installer les dépendances (inclut mediasoup)
RUN npm ci --only=production

# Copier le serveur Mediasoup et ses modules. Lister les fichiers un à un est
# une source d'oubli : un nouveau module absent de l'image provoque un
# « Cannot find module » au démarrage, après un déploiement complet.
COPY server-mediasoup.js transcription-fork.js ./

# Exposer les ports
EXPOSE 3001
EXPOSE 40000-40199/udp
EXPOSE 40000-40199/tcp

# Variables d'environnement
ENV NODE_ENV=production
ENV MEDIASOUP_PORT=3001

CMD ["node", "server-mediasoup.js"]
