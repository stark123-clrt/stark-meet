# Dockerfile pour le serveur Mediasoup
FROM node:18

# Dépendances système. `ffmpeg` sert au fork RTP de transcription : il reçoit le
# flux Opus du SFU et le convertit en PCM 16 kHz mono.
RUN apt-get update && apt-get install -y \
    build-essential \
    python3 \
    python3-pip \
    net-tools \
    ffmpeg \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copier les fichiers de dépendances
COPY package*.json ./

# Installer les dépendances (inclut mediasoup)
RUN npm ci --only=production

# Copier le serveur Mediasoup et TOUS ses modules.
#
# ⚠️ Le motif est délibéré. La version précédente listait les fichiers un à un,
# et l'ajout de `transcription-stream.js` a fait échouer le démarrage sur un
# « Cannot find module » — après un déploiement complet, donc plusieurs minutes
# avant de voir l'erreur. Un motif ne peut pas oublier un fichier.
#
# Les fichiers de configuration du front (next, tailwind, postcss) sont copiés au
# passage : quelques kilo-octets inertes, contre un mode de panne supprimé.
COPY *.js ./

# Exposer les ports
EXPOSE 3001
EXPOSE 40000-40199/udp
EXPOSE 40000-40199/tcp

# Variables d'environnement
ENV NODE_ENV=production
ENV MEDIASOUP_PORT=3001

CMD ["node", "server-mediasoup.js"]
